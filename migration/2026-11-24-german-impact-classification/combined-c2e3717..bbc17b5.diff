+def _element(element_id, text, element_type="paragraph", *, page=1, y=50, order=1):
+    return {
+        "element_id": element_id,
+        "element_type": element_type,
+        "original_role": {"heading": "sectionHeading", "title": "title"}.get(element_type),
+        "text": text,
