# Copy this file to .env and fill in the values you need.
# .env is gitignored; never commit real credentials.
# Variable names only - no keys, tokens, or internal index URLs belong here.

# --- Azure Document Intelligence: required for real extraction (Stage 01) ---
TIA_API_KEY=<your-tia-api-key>
TIA_AZURE_ENDPOINT=<your-azure-di-endpoint>

# --- Stage 13 provider selection ---
# bbk_ai_hub (internal SDK, default) or openai_compatible
LLM_PROVIDER=bbk_ai_hub
BBK_AI_HUB_API_KEY=<optional-hub-api-key>
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=<optional-openai-base-url>
LLM_MODEL=<required-with-openai-compatible>

# --- Runtime defaults (the offline demo forces mock/generic by itself) ---
# Domain comparison is generic only. CRR_DOMAIN_MODE is retired: unset/blank/
# auto resolve to generic and an explicit crr3 fails. CRR_EVIDENCE_DIR is
# retired and has no production consumer, so no CRR evidence path is needed.
CRR_RUN_LLM=mock
CRR_API_BASE=http://127.0.0.1:8321
CRR_MCP_UPLOAD_ROOT=./input
CRR_PROJECT_ROOT=./workspace
FASTMCP_CHECK_FOR_UPDATES=off
